// Built studio + real loopback hosted WebSocket room implementation; public
// provider transport is replaced by isolated deterministic test fixtures.
import assert from 'node:assert/strict';
import {resolve} from 'node:path';
import {pathToFileURL} from 'node:url';
import {preview} from 'vite';
import {createHostedLiveServer} from '../../server/hosted';
import status from '../../server/entries/status';
import type {LiveSource} from '../../server/hub';
const root=resolve(import.meta.dirname,'../..');
const entry=resolve(process.env.PLAYWRIGHT_ENTRY??resolve(root,'../neural-field-notes/node_modules/playwright/index.mjs'));
const {chromium}=await import(pathToFileURL(entry).href);
delete process.env.OVERLAY_HOSTED_TIKTOK;
process.env.OVERLAY_CHAT_PLATFORM='youtube';
process.env.OVERLAY_TWITCH_CHANNEL='dQw4w9WgXcQ';
const opened:string[]=[],closed:string[]=[];
const source:LiveSource={connect(o){const key=o.platform+':'+o.channel;opened.push(key);o.onStateChange?.('connected');return {close:()=>closed.push(key)};},emotes:async(_channel,platform)=>({emotes:{},complete:platform!=='tiktok'})};
const host=createHostedLiveServer({platform:'youtube',channel:'dQw4w9WgXcQ',source,cosmetics:()=>({resolve:async()=>null})});
const server=await preview({root,preview:{host:'127.0.0.1',port:0},logLevel:'error',plugins:[{name:'hosted-source-fixture',configurePreviewServer(s){s.middlewares.use('/api/live/status',(req,res)=>status(req,res));}}]});
const upgrade=host.listeners('upgrade')[0]! as (req:import('node:http').IncomingMessage,socket:import('node:stream').Duplex,head:Buffer)=>void;
server.httpServer.on('upgrade',upgrade);
let browser;
try{
 browser=await chromium.launch({headless:true,executablePath:process.env.BROWSER_BIN??'/usr/bin/google-chrome-beta',args:['--no-sandbox','--disable-dev-shm-usage']});
 const page=await browser.newPage({viewport:{width:1440,height:900}});
 const sockets=new Map<string,Set<number>>(),ever=new Map<string,number>();let seq=0;
 const errors:string[]=[];page.on('pageerror',(e:Error)=>errors.push(e.message));
 page.on('websocket',(ws:{url():string;on(event:'close',cb:()=>void):void})=>{
  const url=new URL(ws.url());if(url.pathname!=='/api/live')return;
  const key=url.searchParams.get('platform')+':'+url.searchParams.get('channel');
  const ids=sockets.get(key)??new Set<number>();sockets.set(key,ids);const id=++seq;ids.add(id);
  ever.set(key,(ever.get(key)??0)+1);ws.on('close',()=>ids.delete(id));
 });
 const wait=async(fn:()=>boolean)=>{const deadline=Date.now()+10000;while(!fn()&&Date.now()<deadline)await new Promise(r=>setTimeout(r,50));assert.ok(fn());};
 const youtube='youtube:dQw4w9WgXcQ',tiktok='tiktok:fixture_tiktok';
 await page.goto(server.resolvedUrls!.local[0]!);
 await page.locator('#open-accounts').click();
 const accounts=page.locator('#accounts-dialog');
 await page.waitForFunction(()=>document.querySelector('#accounts-notice')?.textContent?.includes('This hosted editor'));
 assert.equal(await accounts.locator('.account-actions button').count(),0);
 await page.keyboard.press('Escape');assert.ok(await accounts.isHidden());
 const ytChip=page.locator('#live-sources .live-source-chip[data-platform=youtube]'),ttChip=page.locator('#live-sources .live-source-chip[data-platform=tiktok]');
 await ytChip.locator('[data-mingcute=signal][data-state=connected]').waitFor();
 await ytChip.locator('[data-mingcute=emoji][data-state=ready]').waitFor();
 await wait(()=>sockets.get(youtube)?.size===5);
 const initialIds=[...sockets.get(youtube)!];
 await page.locator('#edit-avatars').hover();
 await page.locator('#enable-avatars').click();
 await wait(()=>sockets.get(youtube)?.size===4);
 await page.waitForFunction(()=>document.querySelector<HTMLIFrameElement>('#avatars-preview')?.contentDocument?.URL==='about:blank');
 assert.ok([...sockets.get(youtube)!].every(id=>initialIds.includes(id)));
 await page.locator('#compare-previews').click();
 assert.equal(await page.locator('.preview-card:visible').count(),3);
 await page.locator('#compare-previews').click();
 await page.locator('#edit-avatars').hover();await page.locator('#enable-avatars').click();
 await wait(()=>sockets.get(youtube)?.size===5);
 assert.equal([...sockets.get(youtube)!].filter(id=>initialIds.includes(id)).length,4);
 assert.equal(ever.get(youtube),6);

 await page.locator('#live-platform-trigger').click();
 await page.locator('#live-platform-menu button[data-platform=tiktok]').click();
 await page.locator('#live-channel').fill('@fixture_tiktok');await page.locator('#live-toggle').click();
 await ttChip.locator('[data-mingcute=signal][data-state=connected]').waitFor();
 await ttChip.locator('[data-mingcute=emoji][data-state=degraded]').waitFor();
 await ytChip.locator('[data-mingcute=emoji][data-state=ready]').waitFor();
 await wait(()=>sockets.get(tiktok)?.size===5);
 const ytIds=[...sockets.get(youtube)!];const ttIds=[...sockets.get(tiktok)!];
 await ttChip.click();await page.locator('#live-source-menu [data-action=reconnect]').click();
 await wait(()=>sockets.get(tiktok)?.size===5&&[...sockets.get(tiktok)!].every(id=>!ttIds.includes(id)));
 assert.deepEqual([...sockets.get(youtube)!],ytIds);
 assert.equal(ever.get(youtube),6);
 await ttChip.click();await page.locator('#live-source-menu [data-action=disconnect]').click();
 await ttChip.waitFor({state:'detached'});await wait(()=>sockets.get(tiktok)?.size===0);
 assert.deepEqual([...sockets.get(youtube)!],ytIds);
 await ytChip.click();await page.locator('#live-source-menu [data-action=disconnect]').click();
 await ytChip.waitFor({state:'detached'});await wait(()=>sockets.get(youtube)?.size===0);
 await page.reload();await page.waitForTimeout(1200);
 assert.equal(await page.locator('#live-sources .live-source-chip').count(),0);
 assert.equal([...sockets.values()].reduce((sum,ids)=>sum+ids.size,0),0);
 assert.deepEqual(errors,[]);
 console.log('HOSTED SOURCE MENU PASS',JSON.stringify({ever:[...ever],opened,closed,errors}));
}finally{await browser?.close();server.httpServer.off('upgrade',upgrade);await new Promise<void>(r=>server.httpServer.close(()=>r()));host.emit('close');}
