{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals", "vite/client"],
    "noEmit": true
  },
  "include": ["src", "server", "api", "tests", "demo", "vite.config.ts"]
}
